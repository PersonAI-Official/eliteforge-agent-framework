    "filesystem.read_text": {
      "en-US": {
        "name": "File Read Text",
        "description": null
      },
      "zh-CN": {
        "name": "读取文件",
        "description": "批量读取授权目录中的文本文件，可指定行范围；宿主记录实际返回内容的版本与读取范围。会话附件不授予工作区编辑凭证。"
      }
    },
    "filesystem.list": {
      "en-US": {
        "name": "File List",
        "description": null
      },
      "zh-CN": {
        "name": "列出文件",
