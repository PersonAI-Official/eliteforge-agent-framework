    "system.command.exec": {
      "en-US": {
        "name": "System Command Exec",
        "description": null
      },
      "zh-CN": {
        "name": "执行命令",
        "description": "在授权工作目录执行完整命令。每路输出返回默认 16KiB 预览及分页元数据，进程完成后仍可能需要续读。按 nextCursor 续读；从零连续读取、所有页 droppedBytes 为零、两路 hasMore 为 false 且 captureStatus 为 eof 时才是完整输出。captureToFile 可独立保存会话附件；检查 fileCapture 状态与采集状态，容量超限及写入失败会明确报告。"
      }
    },
    "system.command.task.read": {
      "en-US": {
        "name": "System Command Task Read",
        "description": null
      },
      "zh-CN": {
        "name": "读取命令输出",
        "description": "按 stdout.nextCursor、stderr.nextCursor 续读命令输出，包括已完成的命令。hasMore 表示还有已采集内容，droppedBytes 表示请求位置后的数据缺口；captureStatus 为 eof 才表示正常采集结束。UTF-8 字符可能使单页超出字节预算最多 3 字节。"
      }
    },
    "system.command.task.stop": {
      "en-US": {
        "name": "System Command Task Stop",
