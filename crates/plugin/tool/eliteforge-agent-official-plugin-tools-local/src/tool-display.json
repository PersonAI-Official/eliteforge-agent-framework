      }
    },
    "filesystem.write_text": {
      "en-US": {
        "name": "File Write Text",
        "description": null
      },
      "zh-CN": {
        "name": "写入文件",
        "description": "通过 items 批量创建、完整覆盖或追加文件，必须指定 mode。创建要求目标不存在，覆盖要求完整且未过期的读取基线，追加写入最新内容。局部修改优先使用 fs_apply_patch。"
      }
    },
